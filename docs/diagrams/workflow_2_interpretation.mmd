  S12A["12a - Aggregate model<br/>21 features - 1 to 10"]:::interp
  S12B["12b - Mamba sequence model<br/>48 steps - 1 to 10"]:::interp
  S13["13 - Scene graph, profiles, report<br/>both scores side by side<br/>on-task % reported separately"]:::interp

  PREV --> S7 --> G4
  G4 -- no --> X4
  G4 -- yes --> S8

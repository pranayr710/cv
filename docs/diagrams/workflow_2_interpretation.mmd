  PREV["from step 6"]:::gate
  S7["7 - Scene layout<br/>intersect the facing rays"]:::interp
  G4{"3 or more<br/>students?"}:::gate
  X4["Layout unknown<br/>a turned head decides nothing"]:::giveup
  S8["8 - Action rules<br/>geometry first, 17 actions"]:::interp
  G5{"any<br/>evidence?"}:::gate
  X5["Action is unknown<br/>never defaults to attentive"]:::giveup
  S9["9 - Expression + posture<br/>8 classes to 3; lean always reported"]:::interp
  S10["10 - Temporal tracker<br/>blink vs closure, rolling %"]:::interp

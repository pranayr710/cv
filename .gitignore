__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.venv/
venv/
ENV/
env/
.env
.ipynb_checkpoints/

datasets/
dataset/

# Pipeline output (JSONL can reach megabytes per clip)
outputs/

# Model weights: ultralytics auto-downloads yolo11m.pt on first use and
# sixdrepnet fetches its own checkpoint. Never commit them.
*.pt
*.pth
weights/

# Generated PPT layout previews (regenerate with verify_ppt.py)
ppt_preview/

# Ultralytics training runs (weights + plots; regenerate with tools/train_behaviour.py)
runs/

# Presentation binaries and their source images (regenerate with build_ppt.py)
*.pptx
ppt_assets/
*.zip

# Labelling package: extracted crops are ~130 MB of JPEGs regenerable from the
# pipeline outputs plus the source clips (labeling/prepare_package.py). The
# manifest and the labels themselves ARE tracked -- they are small, and the
# labels are hand-produced work that cannot be regenerated.
labeling/images/
labeling/images/_duplicates/
labeling/images/calibration/*.jpg
outputs/engagement_features.npz
outputs/image_engagement_scores.csv
labeling/to_label_next.json
outputs/window_labels_with_image_feature.json

# ...but the trained scorers themselves DO ship. They are kilobytes, they are
# the actual deliverable, and regenerating them needs the graph log that
# outputs/ excludes -- so without these a fresh clone silently falls back to
# the rule-based verdict that scored 0.447.
!outputs/window_engagement_model.json
!outputs/mamba_attention_model.pt
!outputs/window_model_report.json
!outputs/mamba_model_report.json
!outputs/semi_supervised_report.json
!outputs/label_spreading_check.json
!outputs/vision_mamba_report.json
!outputs/classifier_comparison.json
!outputs/engagement_scorer_report.json
!outputs/score_method_comparison.json

# Build artifacts from `pip install -e .`
*.egg-info/
build/
dist/
outputs/*.db

# Migration backups: regenerated by tools/migrate_labels_peer.py, and the
# labels themselves are tracked, so these are recovery copies rather than
# history.
labeling/*.json.bak
